# Source of truth for the build config. sdkconfig is derived from this and
# gitignored -- but edits here are IGNORED once sdkconfig exists. Regenerate and
# diff (see the tab5-board skill) rather than hand-editing sdkconfig.
#
# Started from the m5stack_tab5 BSP display example (sdkconfig.bsp.m5stack_tab5).

CONFIG_IDF_TARGET="esp32p4"

# Tab5 has 16 MB flash (the example ships with 4 MB).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Wi-Fi is the on-board ESP32-C6 over SDIO (esp_hosted). The board option
# supplies the SDIO pins; do not hand-set them.
CONFIG_ESP32P4_TAB5_C6_BOARD=y
# The Tab5 board option defaults to active-low reset, which on this hardware
# leaves the C6 unenumerated (sdmmc send_op_cond 0x107). See the tab5-board skill.
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_LOW=n
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y

CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n
CONFIG_CAM_CTRL_SPI_ENABLE=n

# SPIRAM for ESP32-P4
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

## LVGL9 ##
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_BUILD_EXAMPLES=n

# CLIB default
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_CLIB_STRING=y

# Fonts. 14 px is ~1.2 mm tall on this 5" 720p panel, so it is for small print only.
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
# Morning page: departures and the leave-by bar at 36 px, read from 3 m
# (PLAN.md §5); the clock at 48.
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# The UI is landscape on a portrait panel: rotate on the P4's PPA rather than
# the CPU, to shorten each flush and the tear window (tab5-board skill).
CONFIG_LVGL_PORT_ENABLE_PPA=y

# TLS buffers in PSRAM: handshakes are hungry and internal RAM is shared with Wi-Fi.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Performance monitor
CONFIG_LV_USE_OBSERVER=y
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y
