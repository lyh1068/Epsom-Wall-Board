# Source of truth for the build config. sdkconfig is derived from this and
# gitignored -- but edits here are IGNORED once sdkconfig exists. Regenerate and
# diff (see the tab5-board skill) rather than hand-editing sdkconfig.
#
# Started from the m5stack_tab5 BSP display example (sdkconfig.bsp.m5stack_tab5).

CONFIG_IDF_TARGET="esp32p4"

# Tab5 has 16 MB flash (the example ships with 4 MB).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n
CONFIG_CAM_CTRL_SPI_ENABLE=n

# SPIRAM for ESP32-P4
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

## LVGL9 ##
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_BUILD_EXAMPLES=n

# CLIB default
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_CLIB_STRING=y

# Performance monitor
CONFIG_LV_USE_OBSERVER=y
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y
