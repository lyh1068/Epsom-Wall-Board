# Copy this file to .env and fill in your own values.
#
#     cp .env.example .env
#
# .env is gitignored. The build turns it into a generated header
# (wallboard_secrets.h) inside the build directory, so you never edit a source
# file to set these and nothing with a real value is ever tracked.
#
# Real environment variables win over this file, so you can also
# `export TFL_APP_KEY=...` and keep a key off disk entirely.
#
# Every value below has a placeholder fallback, and the build succeeds with the
# placeholders in place. That is deliberate: the rail key needs an approval that
# can take days, and the radar, weather and clock phases must be buildable
# without it. A source left as a placeholder should show as unavailable on the
# board rather than breaking the build.

# The Tab5's radio is the on-board ESP32-C6 over SDIO. It is 2.4 GHz only --
# a 5 GHz network will not be found, however correct the password is.
# Quote the value if it contains a '#' or has meaningful leading/trailing
# spaces:  WIFI_PASSWORD="hunter2 # really"
WIFI_SSID=your-ssid
WIFI_PASSWORD=your-password

# Rail Data Marketplace -- "Live Departure Board" (Darwin LDBWS, JSON REST).
# Register at https://raildata.org.uk/ and subscribe to the product; approval
# can take several days. The exact header name to send this in is shown on the
# product's Specification tab, so check there rather than guessing.
RAIL_DATA_KEY=REPLACE-ME

# TfL Unified API app_key, from https://api-portal.tfl.gov.uk/
# Used for /Line/{ids}/Status. Issued immediately on registration.
TFL_APP_KEY=REPLACE-ME

# Radar centre in decimal degrees (optional). Left empty, the radar centres on
# Epsom station. Only a rounded (~1 km) position is ever sent to the aircraft API.
HOME_LAT=
HOME_LON=
